<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AdPlatform.Google</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GoogleOAuth.fs" />
    <Compile Include="GoogleAdsClient.fs" />
    <Compile Include="GoogleAdsJsonElement.fs" />
    <Compile Include="GoogleAdsCredentialQuery.fs" />
    <Compile Include="GoogleAdsPlatformAdQuery.fs" />
    <Compile Include="GoogleAdsPlatformQueryProvider.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdAutomation.Core\AdAutomation.Core.fsproj" />
    <ProjectReference Include="..\AdCredentials\AdCredentials.fsproj" />
  </ItemGroup>

</Project>

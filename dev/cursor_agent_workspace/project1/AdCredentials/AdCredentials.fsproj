<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AdCredentials</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdAutomation.Core\AdAutomation.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="CredentialFileDto.fs" />
    <Compile Include="ResolvedCredential.fs" />
    <Compile Include="GoogleAdsCredentials.fs" />
    <Compile Include="GoogleAdsCredentialBundle.fs" />
    <Compile Include="AdCredentialsStore.fs" />
    <Compile Include="CredentialKeyValidator.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="credentials.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

{
  "name": "mcp-pixel-studio",
  "version": "0.1.0",
  "description": "MCP server for creating and editing pixel-art images on server-side canvases",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-pixel-studio": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/core.test.ts test/mcp.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

  "dialogues": {
    "event-forest-start": {
      "name": "第二章開局",
      "steps": [
        {
          "id": "forest-start-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵離開青石村，一路向東，踏入茫茫林海。林間妖氣瀰漫，鳥獸絕跡，唯有風穿林梢的嗚咽聲。"
        },
        {
          "id": "forest-start-2",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "站住！你是何人，竟敢孤身闖入這片妖林？"
        },
        {
          "id": "forest-start-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "在下凌淵，自青石村而來，追尋妖氣源頭至此。"
        },
        {
          "id": "forest-start-4",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "青石村……你這運勁之法，老夫看著眼熟。這可是守護者一脈的傳承？"
        },
        {
          "id": "forest-start-5",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "守護者一脈？我自幼在青石村長大，只知師父傳我這套功法，卻不知其名。"
        },
        {
          "id": "forest-start-6",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "錯不了。老夫年輕時見過守護者出手，你這運勁之法與他一模一樣。這林海深處的妖物巢穴，恐怕與你師父當年封印的妖王脫不了干係。"
        },
        {
          "id": "forest-start-7",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "師父……他老人家早已仙逝。若這巢穴真與他有關，我更該查明真相。"
        },
        {
          "id": "forest-start-8",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "好！老夫這獵人村落願助你一臂之力。那座妖王巢穴日夜生出妖物，威脅村落，你若能將它連根拔起，便是救了全村性命！"
        }
      ]
    },
    "event-hunter-talk": {
      "name": "與獵人交談",
      "steps": [
        {
          "id": "hunter-talk-1",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "少俠，那妖王巢穴就藏於林海深處。巢穴妖氣濃烈，日夜生出妖物，老夫的獵人村落已快抵擋不住了。"
        },
        {
          "id": "hunter-talk-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "老獵放心，我這便深入林海，將那妖王巢穴連根拔起。"
        },
        {
          "id": "hunter-talk-3",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "老夫在此備好丹藥與箭矢，你若有需要，隨時可回村落補給。"
        }
      ]
    },
    "event-victory": {
      "name": "林海安寧",
      "steps": [
        {
          "id": "victory-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "最後一座妖物巢穴轟然倒塌，籠罩林海多時的妖氣終於徹底消散。陽光重新灑落林間，鳥鳴聲漸起。"
        },
        {
          "id": "victory-2",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "少俠果然了得！妖王巢穴一除，這下獵人村落終於能安寧了！"
        },
        {
          "id": "victory-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "老獵，你方才說我這功法是守護者一脈……能否再多說一些？"
        },
        {
          "id": "victory-4",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "老夫所知不多，只知守護者一脈世代守護山河，鎮壓妖邪。你既承此功法，日後必有大任。往東去，或許能尋得更多線索。"
        },
        {
          "id": "victory-5",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "多謝老獵指點。江湖路長，我們後會有期。"
        }
      ]
    },
    "dialogue-mt4rm7fn": {
      "name": "幫忙挖礦",
      "steps": [
        {
          "id": "step-mt4rm7fn-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵來到礦脈前，幾名獵人村民正揮汗挖掘，礦石在陽光下泛著微光。"
        },
        {
          "id": "step-mt4rm7fn-2",
          "speakerName": "獵人村民",
          "speakerIcon": "⛏️",
          "content": "少俠來得正好！這座礦脈是村裡的資源點，挖出的礦石能化作建料，供村落建設之用。"
        },
        {
          "id": "step-mt4rm7fn-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "建料……原來如此。據點要建造建築、修築防禦，都少不了這些建料。"
        },
        {
          "id": "step-mt4rm7fn-4",
          "speakerName": "獵人村民",
          "speakerIcon": "⛏️",
          "content": "正是！只要守住這資源點，每回合都能為村落產出建料。妖物若來襲，建料充足才能築起防線。"
        },
        {
          "id": "step-mt4rm7fn-5",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵挽起衣袖，幫村民挖掘礦脈。礦石化作建料，源源送往獵人村落。"
        },
        {
          "id": "step-mt4rm7fn-6",
          "speakerName": "獵人村民",
          "speakerIcon": "⛏️",
          "content": "多謝少俠相助！這張落石符是村裡珍藏的土系符籙，危急時可轟落巨石傷敵，就贈予少俠聊表謝意。"
        },
        {
          "id": "step-mt4rm7fn-7",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "多謝。這落石符我便收下了，日後對敵時必能派上用場。"
        }
      ]
    },
    "dialogue-mt789msi": {
      "name": "到達門派",
      "steps": [
        {
          "id": "sect-arrive-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵循著山徑深入林海，一座隱於蒼翠之間的金剛武館赫然映入眼簾。門前石獅威嚴，匾額上「金剛」二字蒼勁有力。"
        },
        {
          "id": "sect-arrive-2",
          "speakerName": "守門弟子",
          "speakerIcon": "🥋",
          "content": "來者何人？此地乃金剛武館，非門中弟子不得擅闖。"
        },
        {
          "id": "sect-arrive-3",
          "speakerName": "凌淵",
          "speakerIcon": "🧙",
          "content": "在下凌淵，追尋妖氣源頭途經此地，見貴派威名遠播，特來拜會，還望通報一聲。"
        },
        {
          "id": "sect-arrive-4",
          "speakerName": "守門弟子",
          "speakerIcon": "🥋",
          "content": "原來是斬妖除魔的俠士。此事好辦，我這便帶你入內見掌門。"
        },
        {
          "id": "sect-arrive-5",
          "speakerName": "金剛掌門",
          "speakerIcon": "🥋",
          "content": "少俠一身剛猛正氣，與我金剛流頗有淵源。既到武館，不妨在此歇腳。我金剛武館除了可學習金剛流內外功法，也打造有鎧甲兵刃，供門中弟子購置對敵。"
        },
        {
          "id": "sect-arrive-6",
          "speakerName": "凌淵",
          "speakerIcon": "🧙",
          "content": "學習功法與購置裝備？敢問掌門該如何進行？"
        },
        {
          "id": "sect-arrive-7",
          "speakerName": "金剛掌門",
          "speakerIcon": "🥋",
          "content": "其一，武館內設有藏經閣，你可前往參觀。只要付出足夠的聲望與金錢，便能擇一門合適的內功或外功修習；武館愈高，能傳授的功法便愈精深。"
        },
        {
          "id": "sect-arrive-8",
          "speakerName": "金剛掌門",
          "speakerIcon": "🥋",
          "content": "其二，館旁的兵器坊陳列著我金剛流的鎧甲與兵刃。你可用金錢購置，增添攻防。切記量力而為，選與自身功法相配的裝備方是上策。"
        },
        {
          "id": "sect-arrive-9",
          "speakerName": "凌淵",
          "speakerIcon": "🧙",
          "content": "多謝掌門指點。學得功法、添置裝備，我斬妖除魔的底氣便更足了。"
        },
        {
          "id": "sect-arrive-10",
          "speakerName": "金剛掌門",
          "speakerIcon": "🥋",
          "content": "善。妖氣源頭仍在林海深處，少俠多加保重。金剛武館的大門，永遠為除魔衛道的俠士敞開。"
        }
      ]
    },
    "dialogue-mt78iimj": {
      "name": "到達巢穴",
      "steps": [
        {
          "id": "nest-arrive-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "越過重重密林，妖氣愈發濃烈。前方的樹木盡皆枯槁，枝椏扭曲如爪，隱約可見一座被墨色妖氣籠罩的巢穴，發出陣陣低沉的嗡鳴。"
        },
        {
          "id": "nest-arrive-2",
          "speakerName": "凌淵",
          "speakerIcon": "🧙",
          "content": "這股妖氣……與獵人所言相符，想必就是那妖物巢穴了。只是這妖氣如此濃重，恐怕巢中妖物不在少數。"
        },
        {
          "id": "nest-arrive-3",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "巢穴深處忽然傳來一聲淒厲的咆哮，一名周身纏繞妖氣的妖衛猛然竄出，攔在凌淵身前，齜牙咧嘴，目露凶光。"
        },
        {
          "id": "nest-arrive-4",
          "speakerName": "巢穴妖衛",
          "speakerIcon": "🐺",
          "content": "吼——擅闖巢穴者，殺無赦！"
        },
        {
          "id": "nest-arrive-5",
          "speakerName": "凌淵",
          "speakerIcon": "🧙",
          "content": "果然盤踞著妖物。老獵說得對，若不將這巢穴連根拔起，獵人村落遲早被這源源不絕的妖物吞沒。"
        },
        {
          "id": "nest-arrive-6",
          "speakerName": "凌淵",
          "speakerIcon": "🧙",
          "content": "妖物，就讓我用手中招式，替這片林海除害！"
        },
        {
          "id": "nest-arrive-7",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵凝神運勁，氣機流轉周身，向妖衛與巢穴逼近。一場廝殺，一觸即發。"
        }
      ]
    },
    "dialogue-mt7al8fd": {
      "name": "擊殺妖獸首領",
      "steps": [
        {
          "id": "beast-slain-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "妖衛首領在凌淵的攻勢下發出最後一聲淒厲的咆哮，龐大的身軀轟然倒地，化作一縷黑煙消散於空中。"
        },
        {
          "id": "beast-slain-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "呼……好險，這妖物出手狠辣，若非平日不輟練功，只怕已倒在這裡。"
        },
        {
          "id": "beast-slain-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "守巢的妖獸首領已除，接下來便只剩那座妖王巢穴了。只要將其摧毀，這片林海的妖氣源頭便徹底斷絕！"
        },
        {
          "id": "beast-slain-4",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵凝神望向不遠處那座仍在嗡嗡作響的妖王巢穴，提氣運勁，準備迎接最後一戰。"
        }
      ]
    }
  },

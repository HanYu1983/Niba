  "dialogues": {
    "event-forest-start": {
      "name": "第二章開局",
      "steps": [
        {
          "id": "forest-start-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵離開青石村，一路向東，踏入茫茫林海。林間妖氣瀰漫，鳥獸絕跡，唯有風穿林梢的嗚咽聲。"
        },
        {
          "id": "forest-start-2",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "站住！你是何人，竟敢孤身闖入這片妖林？"
        },
        {
          "id": "forest-start-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "在下凌淵，自青石村而來，追尋妖氣源頭至此。"
        },
        {
          "id": "forest-start-4",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "青石村……你這運勁之法，老夫看著眼熟。這可是守護者一脈的傳承？"
        },
        {
          "id": "forest-start-5",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "守護者一脈？我自幼在青石村長大，只知師父傳我這套功法，卻不知其名。"
        },
        {
          "id": "forest-start-6",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "錯不了。老夫年輕時見過守護者出手，你這運勁之法與他一模一樣。這林海深處的妖物巢穴，恐怕與你師父當年封印的妖王脫不了干係。"
        },
        {
          "id": "forest-start-7",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "師父……他老人家早已仙逝。若這巢穴真與他有關，我更該查明真相。"
        },
        {
          "id": "forest-start-8",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "好！老夫這獵人村落願助你一臂之力。那兩座巢穴日夜生出妖物，威脅村落，你若能將它們盡數摧毀，便是救了全村性命！"
        }
      ]
    },
    "event-hunter-talk": {
      "name": "與獵人交談",
      "steps": [
        {
          "id": "hunter-talk-1",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "少俠，那兩座巢穴一東一南，藏於林海深處。巢穴妖氣濃烈，日夜生出妖物，老夫的獵人村落已快抵擋不住了。"
        },
        {
          "id": "hunter-talk-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "老獵放心，我這便深入林海，將那兩座巢穴連根拔起。"
        },
        {
          "id": "hunter-talk-3",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "老夫在此備好丹藥與箭矢，你若有需要，隨時可回村落補給。"
        }
      ]
    },
    "event-nest-destroyed": {
      "name": "巢穴被摧毀",
      "steps": [
        {
          "id": "nest-destroyed-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "轟然一聲巨響，妖物巢穴在凌淵的攻勢下轟然崩塌，盤踞其上的妖氣如煙般消散。"
        },
        {
          "id": "nest-destroyed-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "一座巢穴已除。還剩一座，妖氣源頭便斷了。"
        }
      ]
    },
    "event-victory": {
      "name": "林海安寧",
      "steps": [
        {
          "id": "victory-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "最後一座妖物巢穴轟然倒塌，籠罩林海多時的妖氣終於徹底消散。陽光重新灑落林間，鳥鳴聲漸起。"
        },
        {
          "id": "victory-2",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "少俠果然了得！兩座巢穴盡數摧毀，這下獵人村落終於能安寧了！"
        },
        {
          "id": "victory-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "老獵，你方才說我這功法是守護者一脈……能否再多說一些？"
        },
        {
          "id": "victory-4",
          "speakerName": "獵人 老獵",
          "speakerIcon": "🏹",
          "content": "老夫所知不多，只知守護者一脈世代守護山河，鎮壓妖邪。你既承此功法，日後必有大任。往東去，或許能尋得更多線索。"
        },
        {
          "id": "victory-5",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "多謝老獵指點。江湖路長，我們後會有期。"
        }
      ]
    },
    "dialogue-mt4rm7fn": {
      "name": "幫忙挖礦",
      "steps": [
        {
          "id": "step-mt4rm7fn-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵來到礦脈前，幾名獵人村民正揮汗挖掘，礦石在陽光下泛著微光。"
        },
        {
          "id": "step-mt4rm7fn-2",
          "speakerName": "獵人村民",
          "speakerIcon": "⛏️",
          "content": "少俠來得正好！這座礦脈是村裡的資源點，挖出的礦石能化作建料，供村落建設之用。"
        },
        {
          "id": "step-mt4rm7fn-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "建料……原來如此。據點要建造建築、修築防禦，都少不了這些建料。"
        },
        {
          "id": "step-mt4rm7fn-4",
          "speakerName": "獵人村民",
          "speakerIcon": "⛏️",
          "content": "正是！只要守住這資源點，每回合都能為村落產出建料。妖物若來襲，建料充足才能築起防線。"
        },
        {
          "id": "step-mt4rm7fn-5",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵挽起衣袖，幫村民挖掘礦脈。礦石化作建料，源源送往獵人村落。"
        },
        {
          "id": "step-mt4rm7fn-6",
          "speakerName": "獵人村民",
          "speakerIcon": "⛏️",
          "content": "多謝少俠相助！這張落石符是村裡珍藏的土系符籙，危急時可轟落巨石傷敵，就贈予少俠聊表謝意。"
        },
        {
          "id": "step-mt4rm7fn-7",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "多謝。這落石符我便收下了，日後對敵時必能派上用場。"
        }
      ]
    }
  },

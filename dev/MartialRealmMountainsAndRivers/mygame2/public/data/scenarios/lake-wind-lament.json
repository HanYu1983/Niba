  "dialogues": {
    "event-chapter3-start": {
      "name": "第三章開局",
      "steps": [
        {
          "id": "chapter3-start-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵離開林海，一路向西，來到了一片廣闊的湖畔。湖水青黑，魚弄絕跡，唯有湖邊村落的村民在湖邊奔走。"
        },
        {
          "id": "chapter3-start-2",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "少使，你來得正好！那湖水不知得了什拗病，青黑發臭，我們靠它過活的人，如今都受苦了！"
        },
        {
          "id": "chapter3-start-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這是...妖氣侵蝕了地脈，湖水受到污染了。放心，我會替你們淨化這片湖水的。"
        }
      ]
    },
    "event-purify-spring": {
      "name": "淨化靈泉",
      "steps": [
        {
          "id": "purify-spring-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵運起內氣，雙掌抵入湖中，青黑色的油污逐漸消散，靈泉水重現清澈，湖風的嗚咽聲也隨之平息。"
        },
        {
          "id": "purify-spring-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "第一處水源已淨化。湖水底下那道隱約的封印印記，與師父所用的手法，似乎同出一脈。"
        }
      ]
    },
    "event-spring2-inspect": {
      "name": "封印痕跡",
      "steps": [
        {
          "id": "spring2-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵仔細查看泉眼，發現湖底遺有一道被歲月侵蝕的封印印記，散發著淡淡的靈光。"
        },
        {
          "id": "spring2-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這道封印...難道與師父當年封印妖王的地點有關？湖水受染，恐怕正是封印鬆動的徵兆。"
        }
      ]
    },
    "event-purify-marsh": {
      "name": "淨化沼澤",
      "steps": [
        {
          "id": "purify-marsh-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "沼澤的死水在凌淵的內力之下漸次清淨，露出了底下原先隱藏的靈泉之源。"
        }
      ]
    },
    "dialogue-villager": {
      "name": "村民的苦難",
      "steps": [
        {
          "id": "illager-1",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "湖水濁了以後，村裡的老老少少都相繼出病倒了，還望少快指點一條明路。"
        },
        {
          "id": "illager-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "放心，這湖水裡頭定有妖氣作祟，我定會找出根治之法的。"
        }
      ]
    },
    "event-victory": {
      "name": "湖水復清",
      "steps": [
        {
          "id": "victory-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "湖中妖邪應聲倒下，化作點點螢光消散於水面。三處泉眼同時湧出清泉，湖泊重現波光瀲灩。村民們欣喜奔走至湖畔，捧起清澈湖水。"
        },
        {
          "id": "victory-2",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "湖水清澈了！少俠果然神通廣大，這下全村人都要謝你的大恩大德！敢問恩人尊姓大名，師承何處？"
        },
        {
          "id": "victory-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "晚輩凌淵……至於師承，我自己也說不清了。我只知道，我是被師父帶到青石村，交給村裡撫養長大的。"
        },
        {
          "id": "victory-4",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "師父臨終前告訴我，我們這一脈叫「守護者」——世代鎮守五行平衡，不屬於任何門派。當年妖王作亂，是師父以性命為代價，將它封印在這片地脈之下。"
        },
        {
          "id": "victory-5",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "守護者……難怪！老朽年輕時曾聽祖上說過，青石村建村之初，便有一位高人囑咐：若湖底封印鬆動，自有守護者一脈的傳人前來。原來……等的就是您啊！"
        },
        {
          "id": "victory-6",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "湖底那道封印印記，與師父的手法如出一轍。可這次封印鬆動得太快了——妖王的力量不該這麼快復甦。背後恐怕還有人在暗中破壞封印。"
        },
        {
          "id": "victory-7",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "王伯，謝謝你們。但我的旅途還沒有結束——守護者的使命，是走遍這片山河，守護每一寸被妖氣侵蝕的土地。下一站，我會繼續追查封印背後的黑手。"
        },
        {
          "id": "victory-8",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "晨光灑落湖面，凌淵背起行囊，踏上新的征途。守護者的名字，將隨著他走過的每一寸山河，被更多人記住。"
        }
      ]
    },
    "dialogue-mtd4wfg9": {
      "name": "處理三個泉水后, 妖物出現",
      "steps": [
        {
          "id": "step-mtd4wfg9-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "三處水源皆已淨化，湖泊重現波光瀲灩。然而湖心深處，一道青黑色的妖氣自水底緩緩升起。"
        },
        {
          "id": "step-mtd4wfg9-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "淨化了三處泉眼，妖氣非但沒有消散，反而全部匯往湖心……難道源頭一直藏在那裡？"
        },
        {
          "id": "step-mtd4wfg9-3",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "少俠小心！湖心那處漩渦，是村裡世代相傳的禁地——老一輩說底下鎮著什麼不得了的東西！"
        },
        {
          "id": "step-mtd4wfg9-4",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "話音未落，湖心轟然炸開千層水浪——封印鬆動之處，湖中妖邪現身了！"
        }
      ]
    }
  },

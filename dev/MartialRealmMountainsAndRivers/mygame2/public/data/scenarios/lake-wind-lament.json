  "dialogues": {
    "event-chapter3-start": {
      "name": "第三章開局",
      "steps": [
        {
          "id": "chapter3-start-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵離開林海，一路向西，來到了一片廣闊的湖畔。湖水青黑，魚弄絕跡，唯有湖邊村落的村民在湖邊奔走。"
        },
        {
          "id": "chapter3-start-2",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "少使，你來得正好！那湖水不知得了什拗病，青黑發臭，我們靠它過活的人，如今都受苦了！"
        },
        {
          "id": "chapter3-start-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這是...妖氣侵蝕了地脈，湖水受到污染了。放心，我會替你們淨化這片湖水的。"
        }
      ]
    },
    "event-purify-spring": {
      "name": "淨化靈泉",
      "steps": [
        {
          "id": "purify-spring-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵運起內氣，雙掌抵入湖中，青黑色的油污逐漸消散，靈泉水重現清澈，湖風的嗚咽聲也隨之平息。"
        },
        {
          "id": "purify-spring-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "第一處水源已淨化。湖水底下那道隱約的封印印記，與師父所用的手法，似乎同出一脈。"
        }
      ]
    },
    "event-spring2-inspect": {
      "name": "封印痕跡",
      "steps": [
        {
          "id": "spring2-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵仔細查看泉眼，發現湖底遺有一道被歲月侵蝕的封印印記，散發著淡淡的靈光。"
        },
        {
          "id": "spring2-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這道封印...難道與師父當年封印妖王的地點有關？湖水受染，恐怕正是封印鬆動的徵兆。"
        }
      ]
    },
    "event-purify-marsh": {
      "name": "淨化沼澤",
      "steps": [
        {
          "id": "purify-marsh-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "沼澤的死水在凌淵的內力之下漸次清淨，露出了底下原先隱藏的靈泉之源。"
        }
      ]
    },
    "dialogue-villager": {
      "name": "村民的苦難",
      "steps": [
        {
          "id": "illager-1",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "湖水濁了以後，村裡的老老少少都相繼出病倒了，還望少快指點一條明路。"
        },
        {
          "id": "illager-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "放心，這湖水裡頭定有妖氣作祟，我定會找出根治之法的。"
        }
      ]
    },
    "event-victory": {
      "name": "湖水復清",
      "steps": [
        {
          "id": "victory-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "三處水源皆已淨化，湖泊重現波光瀲灩。村民們欣喜紛盪至湖畔，摔起清澈湖水。"
        },
        {
          "id": "victory-2",
          "speakerName": "村民 王伯",
          "speakerIcon": "👴",
          "content": "湖水清澈了！少快果然神通廣大，這下全村人都要謝你的大恩大德！"
        },
        {
          "id": "victory-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "湖底那封印痕跡，與我師藥的手法如出一轍。看來這片湖泊的妖氣，背後仍有更深層的布局。"
        }
      ]
    }
  },

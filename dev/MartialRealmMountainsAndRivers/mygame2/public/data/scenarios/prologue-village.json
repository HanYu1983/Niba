  "dialogues": {
    "event-prologue-village-start": {
      "name": "序章對話",
      "steps": [
        {
          "id": "prologue-start-1",
          "speakerName": "村長 趙無極",
          "speakerIcon": "👴",
          "content": "少俠，村外妖氣頻生，靈泉也莫名變了色。老夫想請你出手相除，還這片村子一個安寧。"
        },
        {
          "id": "prologue-start-4",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "靈泉變色——這是妖氣侵蝕地脈之兆。村長可知妖物在何處？"
        },
        {
          "id": "prologue-start-5",
          "speakerName": "獵人 老周",
          "speakerIcon": "🏹",
          "content": "老夫見過那妖物，一身青黑，盤踞在村外東北的山嶺上。"
        },
        {
          "id": "prologue-start-6",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "多謝老周指點。我這便收拾行裝，前去會會那妖物。"
        }
      ]
    },
    "event-spring": {
      "name": "調查靈泉",
      "steps": [
        {
          "id": "spring-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵來到靈泉邊，只見泉水泛著詭異的青黑色，隱隱散發著腥臭之氣。"
        },
        {
          "id": "spring-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這泉水……果然如村長所言變了色。妖氣侵蝕地脈，連靈泉都未能倖免。"
        },
        {
          "id": "spring-3",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵俯身細看，發現泉底沉著幾縷青黑色的妖氣，正順著水流緩緩擴散。"
        },
        {
          "id": "spring-4",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "妖氣源頭應在村外東北的山嶺上。若不早日除去那妖物，這靈泉遲早會徹底枯竭。"
        }
      ]
    },
    "event-spring-monster": {
      "name": "靈泉異變",
      "steps": [
        {
          "id": "spring-monster-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "話音未落，靈泉驟然翻湧，一道青黑色的妖氣自泉底衝天而起！"
        },
        {
          "id": "spring-monster-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這妖氣……竟藏著活物！"
        },
        {
          "id": "spring-monster-3",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "妖氣凝形，一隻通體青黑的妖衛自泉中躍出，張牙舞爪地撲向凌淵！"
        },
        {
          "id": "spring-monster-2b",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "（心中思忖）若此戰有變，我可回青石村購置丹藥、雇請郎中療傷，再作打算。"
        }
      ]
    },
    "event-withered-plant": {
      "name": "枯萎的植物",
      "steps": [
        {
          "id": "withered-plant-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵蹲下身，仔細查看那株枯萎的植物。葉片焦黑蜷縮，莖幹上卻滲出一絲暗紅的血氣，妖異絢麗。"
        },
        {
          "id": "withered-plant-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這植物的根部……竟壓著一張符籙，上面畫著晦澀的符文，似在汲取妖血之力。"
        },
        {
          "id": "withered-plant-3",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵拾起那張換元符，收入懷中。此符可將體力轉化為生命，雖有副作用，危急時或可一用。"
        }
      ]
    },
    "event-tower-destroyed": {
      "name": "哨站失守",
      "steps": [
        {
          "id": "tower-destroyed-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "轟然一聲，青石村哨站的箭塔在妖物衝擊下轟然倒塌，化作一地殘骸。"
        },
        {
          "id": "tower-destroyed-2",
          "speakerName": "村長 趙無極",
          "speakerIcon": "👴",
          "content": "糟了！連哨站的箭塔都被妖物攻破了……這妖氣只會愈發猖獗，妖物恐怕還會不斷湧來！"
        },
        {
          "id": "tower-destroyed-3",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "村長放心，我這便直取妖王。若再拖延，只怕妖物會越聚越多，屆時就難以收拾了。"
        }
      ]
    },
    "event-nest-investigate": {
      "name": "調查巢穴",
      "steps": [
        {
          "id": "nest-investigate-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵撥開層層藤蔓，一座幽深的巢穴赫然現於眼前。洞口盤繞著青黑色的妖氣，隱隱透出腥臭與低沉的嘶鳴，彷彿整座山嶺都在這巢穴的吐息下微微顫動。"
        },
        {
          "id": "nest-investigate-2",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "這巢穴……妖氣濃得化不開，恐怕正是妖物盤踞的根源。"
        },
        {
          "id": "nest-investigate-3",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "凌淵凝神戒備，正要踏入洞口之際，巢穴深處驟然湧出一股狂暴的妖氣，大地為之震動！"
        },
        {
          "id": "nest-investigate-4",
          "speakerName": "青石妖王",
          "speakerIcon": "👹",
          "content": "吼——！"
        },
        {
          "id": "nest-investigate-5",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "一道青黑色的身影自巢穴中衝天而起，正是盤踞此地的青石妖王！牠雙目赤紅，獠牙畢露，妖氣如潮水般向凌淵壓來。"
        },
        {
          "id": "nest-investigate-6",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "果然是你！今日我便要替青石村除此禍患！"
        }
      ]
    },
    "event-victory": {
      "name": "凱旋",
      "steps": [
        {
          "id": "victory-1",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "青石妖王轟然倒下，籠罩青石村多時的妖氣終於消散。凌淵帶著一身的疲憊與功績，踏入村口。"
        },
        {
          "id": "victory-2",
          "speakerName": "村長 趙無極",
          "speakerIcon": "👴",
          "content": "少俠！你果真除了那妖物，還青石村一個清朗。此恩此德，老夫與全村老少皆銘記在心！"
        },
        {
          "id": "victory-3",
          "speakerName": "獵人 老周",
          "speakerIcon": "🏹",
          "content": "哈哈，老夫就知道你行！這一身本事，往後江湖何處去不得？"
        },
        {
          "id": "victory-4",
          "speakerName": "凌淵",
          "speakerIcon": "🥋",
          "content": "諸位保重。妖患已除，這青石村日後想必也能安穩度日了。江湖路長，我們後會有期。"
        },
        {
          "id": "victory-5",
          "speakerName": "村民們",
          "speakerIcon": "🎉",
          "content": "恭送少俠！願少俠一路平安，他日名動天下！"
        },
        {
          "id": "victory-6",
          "speakerName": "旁白",
          "speakerIcon": "📜",
          "content": "【功法解鎖】守護者傳承覺醒——凌淵領悟了內功「山河歸藏」！此功已存入俠客名冊，可在培養介面花費武學殘卷修習，日後沙盒對局即可裝備。"
        }
      ]
    }
  },

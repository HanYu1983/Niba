(game.basic/card-proto-create
 {:id "empty_character"
  :gsign [:blue :uc]
  :type :character
  :texts [(game.basic/text-create
           {:id "text-1"
            :actions [(game.basic/action-create
                       "action-1"
                       [(game.basic/condition-create "cond1"
                                                     `(fn [~'ctx ~'runtime]
                                                        :tip-1)
                                                     `(fn [~'ctx ~'runtime ~'tip]
                                                        (println "condition action " ~'tip)
                                                        #_(throw (ex-info "acc" {}))
                                                        (update ~'ctx :version inc)))
                        (game.basic/condition-create "cond2"
                                                     `(fn [~'ctx ~'runtime]
                                                        :tip-2)
                                                     `(fn [~'ctx ~'runtime ~'tip]
                                                        (println "condition action " ~'tip)
                                                        #_(throw (ex-info "acc" {}))
                                                        (update ~'ctx :version inc)))]
                       `(fn [~'ctx ~'runtime ~'tips]
                          (println "action action" ~'tips)
                          (update ~'ctx :version inc)))]
            :event-script `(fn [~'ctx ~'runtime ~'event] ~'ctx)
            :effect-script `(fn [~'ctx ~'runtime] ~'ctx)})]})
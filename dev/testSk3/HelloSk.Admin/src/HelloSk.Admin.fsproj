<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>HelloSk.Admin</RootNamespace>
    <FableProject>true</FableProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.8.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="4.2.0" />
    <PackageReference Include="Feliz" Version="2.2.0" />
    <PackageReference Include="Feliz.UseElmish" Version="2.2.0" />
    <PackageReference Include="Fable.Elmish" Version="4.0.0" />
  </ItemGroup>
</Project>

package game;

/**
 * GDD：棋盤格子語意類型，對應踩點後不同的結算分支。
 * 具體數值效果由規剘層決定；此處僅鎖定類型分流。
 */
enum TileKind {
    /** 通路／平地：無強制分支或為中性結算之格。 */
    Plain;

    /** 城池：資源、徵募或持久標記偏向之經濟類結算。 */
    City;

    /** 村落：第三方勢力互動（交易/搶奪/攻占）。 */
    Village;

    /** 資源：落地直接給予最小資源收益（骨架用）。 */
    Resource;

    /** 征戰：以武將數值為核心的對耗／對決類結算。 */
    Battle;

    /** 計略：與計策取得、刷新或強制互動相關之格。 */
    Scheme;

    /** 事件：觸發 ITileEvent（分支選項、強制對話等）；綁定方式由賽局實作決定。 */
    Event;
}

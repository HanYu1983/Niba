<?xml version="1.0" encoding="UTF-8"?>
<project name="Project18" default="build" basedir=".">
  <description>Haxe：類路徑 src，主類別 HelloWorld</description>

  <target name="prepare">
    <mkdir dir="bin"/>
  </target>

  <target name="build" depends="prepare">
    <exec executable="haxe" failonerror="true">
      <arg value="-cp"/>
      <arg value="src"/>
      <arg value="-lib"/>
      <arg value="rxhaxe"/>
      <arg value="-main"/>
      <arg value="HelloWorld"/>
      <arg value="-js"/>
      <arg value="bin/hello.js"/>
    </exec>
  </target>

  <target name="clean">
    <delete dir="bin"/>
  </target>
</project>
